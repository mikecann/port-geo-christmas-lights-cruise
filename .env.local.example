# See the README.md for where all these come from

# Required for the map to work correctly
VITE_GOOGLE_MAPS_API_KEY=

# (optional) required for Cloudflare worker OG tag injection to work
VITE_CONVEX_SITE_URL=

# Setup automatically when you run dev for the first time (convex setup)
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Keep disabled until production collection is explicitly approved.
VITE_ANALYTICS_ENABLED=false
VITE_POSTHOG_KEY=
# Set to https://us.i.posthog.com or https://eu.i.posthog.com
VITE_POSTHOG_HOST=

# Enable after configuring GeoIP + server-side location filtering in PostHog.
# Keep Discard client IP data enabled in project settings.
VITE_ANALYTICS_GEOIP_ENABLED=false
