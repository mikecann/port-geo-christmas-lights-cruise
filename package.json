{
  "name": "port-geo-xmas-lights",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:ts": "tsc -b -w",
    "dev:frontend": "cross-env CLOUDFLARE_ENV=dev vite --open",
    "dev:backend": "convex dev",
    "typecheck": "tsc -b",
    "predev": "convex dev --until-success && convex dashboard",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "preview": "vite preview",
    "test": "tsc -b && vitest run",
    "test:unit": "bun run test --project unit",
    "dev:test": "vitest"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@convex-dev/aggregate": "^0.2.2",
    "@convex-dev/auth": "^0.0.94",
    "@convex-dev/rate-limiter": "^0.4.2",
    "@convex-dev/resend": "^0.2.9",
    "@convex-dev/state-machines": "file:./vendor/convex-dev-state-machines-0.1.0.tgz",
    "@mantine/carousel": "^9.7.2",
    "@mantine/core": "^9.7.2",
    "@mantine/dropzone": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@mantine/notifications": "^9.7.2",
    "@mantine/nprogress": "^9.7.2",
    "@tabler/icons-react": "^3.49.0",
    "@vis.gl/react-google-maps": "^1.10.1",
    "browser-image-compression": "^2.0.2",
    "convex": "^1.47.0",
    "convex-helpers": "^0.1.128",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "fluent-convex": "^0.13.0",
    "posthog-js": "^1.438.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-pattern": "^5.9.2",
    "type-route": "^1.1.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@types/google.maps": "^3.66.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "convex-test": "^0.0.55",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.30",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "convex-helpers": "^0.1.127"
  }
}
