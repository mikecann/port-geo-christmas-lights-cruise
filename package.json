{
  "name": "port-geo-xmas-lights",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:ts": "tsc -b -w",
    "dev:frontend": "cross-env CLOUDFLARE_ENV=dev vite --open",
    "dev:backend": "convex dev",
    "typecheck": "tsc -b",
    "predev": "convex dev --until-success && convex dashboard",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "preview": "vite preview",
    "test": "tsc -b && vitest run",
    "test:unit": "bun run test --project unit",
    "test:e2e": "bun run test --project e2e",
    "dev:test": "vitest"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@aws-sdk/client-s3": "^3.1104.0",
    "@browserbasehq/stagehand": "^3.7.1",
    "@convex-dev/aggregate": "^0.2.2",
    "@convex-dev/auth": "^0.0.94",
    "@convex-dev/r2": "^0.10.2",
    "@convex-dev/resend": "^0.2.6",
    "@mantine/carousel": "^9.5.1",
    "@mantine/core": "^9.5.1",
    "@mantine/dropzone": "^9.5.1",
    "@mantine/form": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "@mantine/nprogress": "^9.5.1",
    "@tabler/icons-react": "^3.46.0",
    "@vis.gl/react-google-maps": "^1.9.0",
    "add": "^2.0.9",
    "browser-image-compression": "^2.0.2",
    "convex": "^1.43.0",
    "convex-helpers": "^0.1.122",
    "dotenv": "^17.4.2",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "execa": "^10.0.1",
    "fluent-convex": "^0.13.0",
    "jose": "^6.2.8",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tree-kill": "^1.2.2",
    "ts-pattern": "^5.9.0",
    "type-route": "^1.1.0",
    "unzipper": "^0.12.5",
    "use-debounce": "^10.1.1",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.0",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@types/google.maps": "^3.65.4",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/unzipper": "^0.10.11",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "convex-test": "^0.0.55",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.25",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tsx": "^4.23.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "wrangler": "^4.119.0"
  }
}
